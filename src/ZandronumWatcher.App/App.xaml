<Application x:Class="ZandronumWatcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#E6121418" />
    <SolidColorBrush x:Key="PanelBorder" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF8E959E" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF5F666E" />
    <SolidColorBrush x:Key="AccentOnline" Color="#FF6FD08C" />
    <SolidColorBrush x:Key="AccentOffline" Color="#FF9A5A5A" />

    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Application.Resources>
</Application>
