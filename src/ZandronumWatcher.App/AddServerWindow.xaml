<Window x:Class="ZandronumWatcher.App.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZandronumWatcher.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AddServerViewModel}"
        Title="Add servers"
        Width="620" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FF15181D"
        Foreground="#FFEDEDED"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#FF1B1F26" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FF232830" />
    <SolidColorBrush x:Key="BorderSoft" Color="#FF2E343D" />
    <SolidColorBrush x:Key="Muted" Color="#FF8E959E" />
    <SolidColorBrush x:Key="Accent" Color="#FF6FD08C" />

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
      <Setter Property="Foreground" Value="#FFEDEDED" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="#FFEDEDED" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
      <Setter Property="Foreground" Value="#FFEDEDED" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2C323B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Add a server to watch" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="Search the public server list, or paste an address you already know."
                 Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="SearchBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Filter by server name, map, game mode or address" />
        <Button Grid.Column="1" Content="Scan list" Margin="8,0,0,0"
                Click="OnScanClick" IsEnabled="{Binding CanScan}" />
      </Grid>
    </StackPanel>

    <!-- Manual address -->
    <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="6"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
            Padding="10" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Address" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" x:Name="ManualBox"
                 Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="host:port — port defaults to 10666" />
        <Button Grid.Column="2" Content="Pin" Margin="8,0,0,0" Click="OnPinManualClick" />
      </Grid>
    </Border>

    <!-- Status, then bulk actions on their own line so the status text is not truncated -->
    <StackPanel Grid.Row="2" Margin="2,10,0,6">
      <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Muted}"
                 FontSize="11" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Pin all shown" Click="OnPinAllClick" Margin="6,0,0,0"
                ToolTip="Pin every server currently listed" />
        <Button Content="Unpin all" Click="OnUnpinAllClick" Margin="6,0,0,0"
                ToolTip="Remove every pinned server" />
        <Button Content="Import from Doomseeker" Click="OnImportDoomseekerClick" Margin="6,0,0,0"
                ToolTip="Copy the custom servers you added in Doomseeker" />
      </StackPanel>
    </StackPanel>

    <!-- Results -->
    <!-- A ListBox, not an ItemsControl: ItemsControl does not virtualise, and with 600+
         servers that means ~10k live visuals and a UI thread that cannot keep up with the
         mouse. ListBox virtualises by default, so only the visible rows exist. -->
    <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="6"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
      <ListBox x:Name="ResultsList"
               ItemsSource="{Binding Results}"
               Background="Transparent"
               BorderThickness="0"
               Foreground="#FFEDEDED"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Item">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowBorder" Property="Background" Value="#FF232830" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="RowBorder" Property="Background" Value="#FF232830" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ServerCandidateViewModel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" />
                  <TextBlock Text="  ·  " Foreground="#FF3A4149" FontSize="11" />
                  <TextBlock Text="{Binding Address}" Foreground="#FF6A727C" FontSize="11"
                             FontFamily="Consolas, Cascadia Mono" />
                </StackPanel>
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding SlotText}" Foreground="{Binding SlotBrush}"
                         FontFamily="Consolas, Cascadia Mono" FontSize="11"
                         VerticalAlignment="Center" Margin="10,0" MinWidth="42" TextAlignment="Right" />

              <Button Grid.Column="2" Style="{StaticResource PinButton}"
                      Content="{Binding PinGlyph}" Foreground="{Binding PinBrush}"
                      ToolTip="{Binding PinTooltip}"
                      Click="OnTogglePinClick" Tag="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Foreground="#FF6A727C" FontSize="11" VerticalAlignment="Center"
                 Text="Changes are saved immediately. Click ✓ on a row to unpin it." />
      <Button Grid.Column="1" Content="Done" Click="OnDoneClick" />
    </Grid>
  </Grid>
</Window>