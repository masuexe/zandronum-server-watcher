<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 TFM is required for the WinRT toast APIs; plain net10.0-windows
         cannot resolve them. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZandronumWatcher.App</RootNamespace>
    <AssemblyName>ZandronumWatcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- System.Drawing (used to draw the tray icon) comes with the Windows Desktop
         framework on this TFM, so no package reference is needed. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZandronumWatcher.Core\ZandronumWatcher.Core.csproj" />
  </ItemGroup>

</Project>